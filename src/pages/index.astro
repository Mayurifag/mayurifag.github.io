---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vlad's personal website">
	<main class="main">
		<p>Hi there! 👋 I'm Vlad, language-agnostic software developer with positive mental attitude! 👨‍💻</p>

		<p>
      Do you need high quality code to be written and deployed fast? Let's connect and discuss how can I contribute to your team!
    </p>

    <p>
      Here will be links to my CV, LinkedIn, GitHub, email and contact details. Eventually. 🙂
    </p>

		<p>
			<span class="console">&gt;</span><b> Vlad Ponomarev</b>
			<span class="console blink"> _</span>
		</p>
	</main>
</Layout>

<style>
	.console {
		color: var(--color-red);
		font-weight: bold;
	}

	.console.blink {
		animation: 1.7s linear infinite condemnedBlinkEffect;
	}

	@keyframes condemnedBlinkEffect {
		0% {
			visibility: hidden;
		}

		50% {
			visibility: hidden;
		}

		100% {
			visibility: visible;
		}
	}
</style>
