---
import Layout from "../layouts/Layout.astro";
---

<Layout title="‎ ">
	<main class="main">
		<p>Hey there 👋</p>

		<p>This is domain I use to host services. 😇</p>

		<p>
			I've decided to remove any contact details to lock in my projects. You
			probably don't have enough budget to work with me anyway. 😁
		</p>

		<p>
			<span class="console">&gt;</span><b> Vladislav Ponomarev</b>
			<span class="console blink"> _</span>
		</p>
	</main>
</Layout>

<style lang="scss">
	.console {
		color: var(--color-red);
		font-weight: bold;

		&.blink {
			animation: 1.7s linear infinite condemnedBlinkEffect;
		}
	}

	@keyframes condemnedBlinkEffect {
		0% {
			visibility: hidden;
		}

		50% {
			visibility: hidden;
		}

		100% {
			visibility: visible;
		}
	}
</style>
