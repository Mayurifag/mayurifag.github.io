---
interface Props {
	title: string;
}

const { title } = Astro.props;

import { Seo } from "astro-seo-meta"
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<Seo
			title="mayurifag.ru"
			description="Software developer, personal website"
			icon="/favicon.svg"
		/>
		<title>{title}</title>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-brown: #b58863;
		--color-darkblue: #2b282e;
		--color-lightbrown: #d3bdb0;
		--color-red: #e43222;
	}

	body {
		background: var(--color-darkblue);
		color: var(--color-lightbrown);
		font-family: 'PT Mono', 'Courier New', 'Fira Code', monospace;
		font-size: 17px;
		-webkit-font-smoothing: antialiased;
		margin: 50px 25px 0;
		max-width: 500px;
	}

	@media (min-width: 601px) {
		body {
			margin: 50px;
		}
	}

	a {
		border-bottom: 1px solid var(--color-brown);
		color: var(--color-brown);
		font-weight: bold;
		text-decoration: none;
	}

	a:hover {
		opacity: 0.9;
	}

	p {
		line-height: 1.65;
		margin: 0 0 24px;
	}
</style>
