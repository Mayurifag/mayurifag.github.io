<style>
	.console {
		color: var(--color-red);
		font-weight: bold;
	}

	.console.blink {
		animation: 1s linear infinite condemnedBlinkEffect;
	}

	@keyframes condemnedBlinkEffect {
		0% {
			visibility: hidden;
		}

		50% {
			visibility: hidden;
		}

		100% {
			visibility: visible;
		}
	}
</style>
